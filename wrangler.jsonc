{
  "name": "haveibeentowed",
  "main": "./edge/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "haveibeentowed-db",
      // Replace with the id printed by: pnpm wrangler d1 create haveibeentowed-db
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "haveibeentowed-media" }
  ],
  "vars": {
    // Comma-separated emails allowed to sign in as operators.
    "OPERATOR_EMAILS": ""
  }
}
